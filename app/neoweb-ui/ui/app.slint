// SPDX-License-Identifier: GPL-3.0-only
// NEOWEB: the browser's chrome on the neoui kit (docs browser-ui.md, canvas Browser page `br2-*`). The header is the
// address bar (B01), the footer five actions (B07); between them the start page (B06) or the engine's page.
import "@neoui/fonts/NeoSans-Regular.ttf";
import "@neoui/fonts/NeoSans-Medium.ttf";
import "@neoui/fonts/NeoSans-SemiBold.ttf";
import "@neoui/fonts/NeoSans-Bold.ttf";
import "@neoui/fonts/DejaVuSans.ttf";
import { Theme, Kit, Scroll, Glyph, HeaderButton, KeyboardFocus } from "@neoui/kit.slint";
import { FieldInput } from "@neoui/components/controls.slint";
import { CrashedPage, FakePages, WebPage } from "pages.slint";

export { Theme, Kit, Scroll, KeyboardFocus }

// A row under the address bar while editing (neoweb-core input::Suggestion): kind 0 history, 1 bookmark, 2 search.
export struct Suggest {
    kind: int,
    title: string,
    url: string,
}

export struct ShortcutTile {
    letters: string,
    label: string,
    color: color,
}

// What the app's Rust shows; taps come back as act(action, value):
// "back" "forward" "search" "tabs" "options" (the footer), "address" "site-info" "bookmark" "reload" "stop" (the
// header), "shortcut" i, "recent" i, "edit-shortcuts" (the start page), "edited" and "go" (typing, Enter in edit mode), "cancel-edit",
// "suggestion" i, "scroll" dp (the page's offset from its top), "tick" (every 100 ms while loading).
export global BrowserState {
    // 0 Start, 1–3 FakePage boards in host previews, 4 engine frame, 5 crashed
    in property <int> page;
    in property <image> frame;
    // neoweb-core Security: 0 none (the empty header), 1 secure, 2 not secure
    in property <int> security;
    in property <string> domain;
    in property <bool> loading;
    in property <float> progress;
    in property <bool> bookmarked;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <string> count: "1";
    in property <[ShortcutTile]> shortcuts;
    in property <[string]> recents;
    // edit mode (br2-address): the field's text and the rows under it
    in property <bool> editing;
    in-out property <string> edit-text;
    in property <[Suggest]> suggestions;
    // B02: header and footer shown; they slide away while reading (br2-reading)
    in property <bool> chrome-shown: true;
    // the page's scroll position (Flickable content-y: 0 at the top, negative further down)
    in-out property <length> page-y;
    callback act(string, int);
}

// The footer's slot: a 24 dp glyph in a 40 dp press circle, dim when disabled (#7d838c at 40 %).
component FooterButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> disabled;
    in property <string> count;
    callback clicked;
    accessible-role: button;
    accessible-label: label;
    Rectangle {
        width: 40 * Theme.dp;
        height: self.width;
        border-radius: self.width / 2;
        background: t.pressed && !root.disabled ? Theme.pressed : transparent;
        Glyph {
            source: root.icon;
            size: Theme.action-glyph;
            colorize: root.disabled ? Theme.text-dim : Theme.text-secondary;
            opacity: root.disabled ? 0.4 : 1;
        }

        // the count inside the tabs glyph's front card
        if root.count != "": Text {
            x: 12 * Theme.dp;
            y: 15.5 * Theme.dp;
            width: 12.5 * Theme.dp;
            height: 12.5 * Theme.dp;
            text: root.count;
            font-size: 9 * Theme.dp;
            font-weight: 700;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    t := TouchArea {
        enabled: !root.disabled;
        clicked => {
            root.clicked();
        }
    }
}

// B07: ← → Search, Opened pages (with the count), Options; actions, not tabs: no pill.
component BrowserFooter inherits Rectangle {
    height: Theme.footer-h;
    background: Theme.header-alt;
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.header-hairline;
    }

    HorizontalLayout {
        FooterButton {
            icon: @image-url("@neoui/icons/sys/back.svg");
            label: "Back";
            disabled: !BrowserState.can-back;
            clicked => { BrowserState.act("back", 0); }
        }

        FooterButton {
            icon: @image-url("icons/forward.svg");
            label: "Forward";
            disabled: !BrowserState.can-forward;
            clicked => { BrowserState.act("forward", 0); }
        }

        FooterButton {
            icon: @image-url("@neoui/icons/sys/search.svg");
            label: "Search or type an address";
            clicked => { BrowserState.act("search", 0); }
        }

        FooterButton {
            icon: @image-url("@neoui/icons/sys/tabs.svg");
            label: "Opened pages, " + BrowserState.count;
            count: BrowserState.count;
            clicked => { BrowserState.act("tabs", 0); }
        }

        FooterButton {
            icon: @image-url("@neoui/icons/sys/apps.svg");
            label: "Options";
            clicked => { BrowserState.act("options", 0); }
        }
    }
}

// B01: the address bar. Empty: "Search or type an address". A page: the security icon + the domain (path hidden),
// ☆ and ⟳ (✕ while loading, with a 2 dp accent progress line under the bar).
component AddressBar inherits Rectangle {
    height: Theme.header-h;
    background: Theme.header-alt;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.header-hairline;
    }

    if !BrowserState.editing && BrowserState.security == 0: TouchArea {
        clicked => { BrowserState.act("address", 0); }
        HorizontalLayout {
            padding-left: 16 * Theme.dp;
            padding-right: 16 * Theme.dp;
            spacing: 12 * Theme.dp;
            alignment: start;
            Glyph {
                y: (parent.height - self.height) / 2;
                source: @image-url("@neoui/icons/sys/search.svg");
                size: 20 * Theme.dp;
                colorize: Theme.text-secondary;
            }

            Text {
                text: "Search or type an address";
                font-size: Theme.font-body;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
        }
    }
    if !BrowserState.editing && BrowserState.security != 0: HorizontalLayout {
        padding-left: 12 * Theme.dp;
        padding-right: 4 * Theme.dp;
        TouchArea {
            horizontal-stretch: 1;
            clicked => { BrowserState.act("address", 0); }
            HorizontalLayout {
                padding-left: 4 * Theme.dp;
                spacing: 9 * Theme.dp;
                alignment: start;
                TouchArea {
                    width: 18 * Theme.dp;
                    clicked => { BrowserState.act("site-info", 0); }
                    Glyph {
                        source: BrowserState.security == 1 ? @image-url("@neoui/icons/sys/lock.svg") : @image-url("@neoui/icons/sys/info.svg");
                        size: 18 * Theme.dp;
                        colorize: Theme.text-secondary;
                    }
                }

                if BrowserState.security == 2: Text {
                    text: "Not secure";
                    font-size: Theme.font-label;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
                Text {
                    text: BrowserState.domain;
                    font-size: Theme.font-body;
                    font-weight: 500;
                    color: Theme.text;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }

        HeaderButton {
            icon: @image-url("@neoui/icons/sys/star.svg");
            label: BrowserState.bookmarked ? "Remove bookmark" : "Bookmark this page";
            tint: BrowserState.bookmarked ? Theme.accent : Theme.text-secondary;
            clicked => { BrowserState.act("bookmark", 0); }
        }

        HeaderButton {
            icon: BrowserState.loading ? @image-url("@neoui/icons/sys/close.svg") : @image-url("@neoui/icons/sys/refresh.svg");
            label: BrowserState.loading ? "Stop loading" : "Reload";
            clicked => { BrowserState.act(BrowserState.loading ? "stop" : "reload", 0); }
        }
    }
    // edit mode (B01): a 40 dp field #1d2025 r20 with the full URL selected, ✕ cancels
    if BrowserState.editing: HorizontalLayout {
        padding-left: 12 * Theme.dp;
        padding-right: 4 * Theme.dp;
        spacing: 4 * Theme.dp;
        VerticalLayout {
            horizontal-stretch: 1;
            // a long URL must not push ✕ away
            min-width: 0;
            alignment: center;
            Rectangle {
                height: Theme.search-h;
                border-radius: self.height / 2;
                background: Theme.field;
                HorizontalLayout {
                    padding-left: 14 * Theme.dp;
                    padding-right: 14 * Theme.dp;
                    FieldInput {
                        min-width: 0;
                        horizontal-stretch: 1;
                        text <=> BrowserState.edit-text;
                        edited => {
                            BrowserState.act("edited", 0);
                        }
                        accepted => {
                            BrowserState.act("go", 0);
                        }
                        init => {
                            self.focus();
                            self.select-all();
                        }
                    }
                }
            }
        }

        HeaderButton {
            icon: @image-url("@neoui/icons/sys/close.svg");
            label: "Cancel editing";
            clicked => { BrowserState.act("cancel-edit", 0); }
        }
    }
    if BrowserState.loading: Rectangle {
        x: 0;
        y: parent.height - 2 * Theme.dp;
        width: parent.width * max(0.05, min(1, BrowserState.progress));
        height: 2 * Theme.dp;
        background: Theme.accent;
    }
}

// B06 (br2-start): Shortcuts 4 × 2 with Edit, then Recently visited.
component StartPage inherits Flickable {
    content-height: col.preferred-height;
    col := VerticalLayout {
        padding: Theme.margin;
        spacing: 14 * Theme.dp;
        alignment: start;
        HorizontalLayout {
            height: 20 * Theme.dp;
            Text {
                text: "Shortcuts";
                font-size: Theme.font-label;
                font-weight: 600;
                color: Theme.text-dim;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            TouchArea {
                width: 60 * Theme.dp;
                clicked => { BrowserState.act("edit-shortcuts", 0); }
                HorizontalLayout {
                    spacing: 6 * Theme.dp;
                    alignment: end;
                    Glyph {
                        y: (parent.height - self.height) / 2;
                        source: @image-url("@neoui/icons/sys/edit.svg");
                        size: 16 * Theme.dp;
                        colorize: Theme.accent;
                    }

                    Text {
                        text: "Edit";
                        font-size: Theme.font-label;
                        font-weight: 600;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                }
            }
        }

        for row in [0, 1]: HorizontalLayout {
            spacing: 8 * Theme.dp;
            for i in [0, 1, 2, 3]: TouchArea {
                property <ShortcutTile> s: BrowserState.shortcuts[row * 4 + i];
                height: 86 * Theme.dp;
                // equal columns whatever the label's length: all stretch from the same preferred width
                min-width: 0;
                preferred-width: 0;
                horizontal-stretch: 1;
                clicked => { BrowserState.act("shortcut", row * 4 + i); }
                VerticalLayout {
                    alignment: center;
                    spacing: 6 * Theme.dp;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 50 * Theme.dp;
                            height: 50 * Theme.dp;
                            border-radius: 14 * Theme.dp;
                            background: s.color;
                            Text {
                                text: s.letters;
                                font-size: 18 * Theme.dp;
                                font-weight: 700;
                                color: white;
                            }
                        }
                    }

                    Text {
                        min-width: 0;
                        overflow: elide;
                        text: s.label;
                        font-size: 13 * Theme.dp;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        if BrowserState.recents.length > 0: Text {
            text: "Recently visited";
            font-size: Theme.font-label;
            font-weight: 600;
            color: Theme.text-dim;
        }
        VerticalLayout {
            spacing: 8 * Theme.dp;
            for r[i] in BrowserState.recents: TouchArea {
                height: 48 * Theme.dp;
                clicked => { BrowserState.act("recent", i); }
                Rectangle {
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    background: parent.pressed ? Theme.pressed : Theme.card;
                    Text {
                        x: 14 * Theme.dp;
                        width: parent.width - 28 * Theme.dp;
                        text: r;
                        font-size: 15.2 * Theme.dp;
                        color: Theme.text;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// br2-address: history rows (clock), bookmark rows (☆), then the web search.
component Suggestions inherits Flickable {
    content-height: col.preferred-height;
    col := VerticalLayout {
        alignment: start;
        for s[i] in BrowserState.suggestions: TouchArea {
            height: Theme.list-row-double-h;
            clicked => { BrowserState.act("suggestion", i); }
            Rectangle {
                background: parent.pressed ? Theme.pressed : transparent;
            }

            HorizontalLayout {
                padding-left: 16 * Theme.dp;
                padding-right: 16 * Theme.dp;
                spacing: 16 * Theme.dp;
                Glyph {
                    y: (parent.height - self.height) / 2;
                    source: s.kind == 0 ? @image-url("@neoui/icons/sys/recents.svg") : s.kind == 1 ? @image-url("@neoui/icons/sys/star.svg") : @image-url("@neoui/icons/sys/search.svg");
                    size: 22 * Theme.dp;
                    colorize: Theme.text-secondary;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 3 * Theme.dp;
                    Text {
                        font-family: "DejaVu Sans";
                        text: s.kind == 2 ? "Search for “" + s.title + "”" : s.title;
                        font-size: Theme.font-body;
                        color: Theme.text;
                        overflow: elide;
                    }

                    Text {
                        font-family: s.kind == 2 ? "NeoSans" : "DejaVu Sans";
                        text: s.kind == 2 ? "Web search" : s.url;
                        font-size: Theme.font-label;
                        color: Theme.text-dim;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

export component BrowserApp inherits Window {
    default-font-family: "NeoSans";
    background: Theme.bg;
    // neoapp sizes the window in surface pixels. Use the same bounds for the image, Resize and page touches.
    out property <int> page-top-px: round(Theme.header-h / 1px);
    out property <int> page-width-px: round(root.width / 1px);
    out property <int> page-height-px: max(0, round((root.height - Theme.footer-h) / 1px) - page-top-px);
    if BrowserState.editing: Suggestions {
        y: Theme.header-h;
        height: root.height - Theme.header-h;
    }
    if !BrowserState.editing: Rectangle {
        x: 0;
        y: root.page-top-px * 1px;
        width: root.page-width-px * 1px;
        height: root.page-height-px * 1px;
        clip: true;
        if BrowserState.page == 0: StartPage { }
        if BrowserState.page == 4: WebPage {
            source: BrowserState.frame;
        }
        if BrowserState.page == 5: CrashedPage {
            reload => { BrowserState.act("reload", 0); }
        }
    }
    // The host's reading boards exercise the sliding chrome over a full-height stand-in page.
    if !BrowserState.editing && BrowserState.page >= 1 && BrowserState.page <= 3: FakePages {
        y: 0;
        height: root.height;
        page: BrowserState.page;
        domain: BrowserState.domain;
        top-pad: Theme.header-h;
        bottom-pad: Theme.footer-h;
        content-y <=> BrowserState.page-y;
        scrolled(dp) => { BrowserState.act("scroll", dp); }
    }
    AddressBar {
        y: BrowserState.chrome-shown ? 0 : -self.height;
        animate y { duration: 150ms; }
    }

    BrowserFooter {
        y: BrowserState.chrome-shown ? root.height - self.height : root.height;
        animate y { duration: 150ms; }
    }

    // br2-reading: "scroll up to show" for 2 s after the chrome hides
    property <bool> shown: BrowserState.chrome-shown;
    property <bool> hint;
    changed shown => {
        root.hint = !root.shown;
    }
    Timer {
        interval: 2s;
        running: root.hint;
        triggered => { root.hint = false; }
    }

    if root.hint: Rectangle {
        y: root.height - 10 * Theme.dp - self.height;
        width: label.preferred-width + 24 * Theme.dp;
        height: 28 * Theme.dp;
        border-radius: 14 * Theme.dp;
        background: #000000a6;
        label := Text {
            text: "scroll up to show";
            font-size: 12.5 * Theme.dp;
            font-weight: 500;
            color: Theme.text-secondary;
        }
    }

    // shortcut: the software renderer bakes in the glyphs of string literals (and Latin-1) only, so page titles in the
    // chrome would lose web punctuation; this never-shown text adds the common ones. A runtime font (WB4's bundled
    // fonts) lifts the limit.
    Text {
        visible: false;
        font-family: "DejaVu Sans";
        text: "–—‘’‚“”„…•·′″‹›«»€£¥©®™°±×÷§¶†‡№";
    }

    // the stand-in engine's load (neoweb-core chrome::Loading)
    Timer {
        interval: 100ms;
        running: BrowserState.loading && BrowserState.page >= 1 && BrowserState.page <= 3;
        triggered => { BrowserState.act("tick", 0); }
    }
}
