{ "name": "gmail", "url": "https://mail.google.com/",
  "steps": [
    { "do": "wait_load" }, { "do": "wait_sel", "sel": "#identifierId", "timeout_ms": 180000 }, { "do": "shot", "name": "signin" },
    { "do": "tap", "sel": "#identifierId" }, { "do": "type", "text": "${WB0_G_USER}", "secret": true },
    { "do": "key", "key": "Enter" },
    { "do": "wait_sel", "sel": "input[type=password]", "timeout_ms": 180000 }, { "do": "tap", "sel": "input[type=password]" },
    { "do": "type", "text": "${WB0_G_PASS}", "secret": true }, { "do": "key", "key": "Enter" },
    { "do": "wait_js", "js": "location.host === 'mail.google.com' && !!document.querySelector('[role=main], .Cp')", "timeout_ms": 300000 },
    { "do": "shot", "name": "inbox" }, { "do": "mem", "name": "end" } ] }
