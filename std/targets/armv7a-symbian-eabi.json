{
  "abi": "eabi",
  "arch": "arm",
  "asm-args": [
    "-mthumb-interwork",
    "-march=armv7-a",
    "-mfpu=neon",
    "-mlittle-endian"
  ],
  "c-enum-min-bits": 32,
  "crt-objects-fallback": "false",
  "data-layout": "e-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64",
  "dynamic-linking": false,
  "emit-debug-gdb-scripts": false,
  "features": "+v7,+thumb2,+vfp3,+d32,+neon,-soft-float,+strict-align,+no-movt",
  "frame-pointer": "always",
  "has-thread-local": false,
  "has-thumb-interworking": true,
  "linker": "rust-lld",
  "linker-flavor": "gnu-lld",
  "llvm-floatabi": "soft",
  "llvm-target": "armv7a-none-eabi",
  "max-atomic-width": 64,
  "metadata": {
    "description": "NeoSymbian user side with std (target_os = \"symbian\", unix family over P.I.P.S.): ARMv7-A + NEON, softfp",
    "host_tools": false,
    "std": true,
    "tier": 3
  },
  "os": "symbian",
  "panic-strategy": "abort",
  "relocation-model": "static",
  "target-family": [
    "unix"
  ],
  "target-pointer-width": 32
}